# Local path to the GLM-5.3 weights directory.
MODEL_DIR=/path/to/GLM-5.3

# Local path to the RedHatAI/GLM-5.3-speculator.dspark directory.
DRAFTER_DIR=/path/to/GLM-5.3-speculator.dspark

# Optional ablation vectors safetensors. Empty = off, bit-identical. When set, must exist
# at the same path on both nodes and is mounted read-only; serve starts with --allow-ablate
# and the engine auto-ablates every request by default (clients may opt out per request with
# "ablate": false). Tensors: ablate.L{L}.attn.r {6144} F32/BF16,
# ablate.L{L}.attn.a {1} F32 (same for ffn). See README for the exact format.
ABLATE_FILE=

# Local TensorFold engine checkout, the build context for `./run.sh image`. Needed on rank 0 only.
ENGINE_DIR=/path/to/TensorFold

# Docker image repository name, without a tag. `./run.sh image` adds a content hash tag and transfers it.
IMAGE=tensorfold-glm53

# SHA-256 of the Zig 0.17.0 aarch64 Linux archive. Required by `./run.sh image`.
ZIG_SHA256=replace-with-the-verified-archive-sha256

# SSH target for rank 1, as accepted by ssh config or ssh user@host syntax.
PEER_SSH=rank1

# Fabric address used by NCCL for rank 0; provide the address on the 200 GbE link.
RANK0_ADDR=FABRIC_ADDRESS

# Optional overrides; leave empty to discover each rank's values from the route to its peer.
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=
NCCL_IB_GID_INDEX=

# HTTP server port on rank 0; defaults to 8888.
PORT=8888

# Maximum prompt plus reply context; defaults to 262144.
CONTEXT=262144

# Default response token limit; defaults to 98304.
MAX_TOKENS=98304

# Host directory for the digest prefix cache; preserve sufficient free and available memory.
CACHE_DIR=/path/to/cache

# Set to 1 to print the discovered link and full rank commands without making changes.
DRY_RUN=0

# Stop both ranks if either node stays below this available-memory floor for this many seconds.
MEMGUARD_FLOOR_GIB=3
MEMGUARD_HOLD_S=4
# Minimum available memory on each node before start.
MIN_AVAIL_GIB=110

# One-shot RoCE all-gather. On by default, adapters found automatically. ROCE=0 uses NCCL only.
ROCE=1
ROCE_HCA=

# Optional extra stop on MemFree plus parked pages. 0 = off. File cache makes MemFree read low, so the guard uses MemAvailable.
MEMGUARD_FREE_GIB=0
